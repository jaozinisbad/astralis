{
  "name": "astralis-client",
  "version": "1.5.3",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "node --test",
    "dev:electron": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron": "electron .",
    "dist:mac": "node scripts/limpar-release.js && vite build && electron-builder --mac dmg",
    "build:icon": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generate-windows-icon.ps1",
    "release": "npm run build:icon && node scripts/limpar-release.js && vite build && electron-builder --publish always",
    "dist": "npm run build:icon && node scripts/limpar-release.js && vite build && electron-builder"
  },
  "build": {
    "appId": "com.appgamers.client",
    "productName": "Astralis",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.ico",
      "package.json"
    ],
    "publish": {
      "provider": "github",
      "owner": "jaozinisbad",
      "repo": "astralis",
      "releaseType": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.social-networking"
    }
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "react-test-renderer": "18.3.1",
    "vite": "^5.4.0",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "@shiguredo/rnnoise-wasm": "^2025.1.5",
    "electron-updater": "^6.3.0",
    "loopback-capture": "^3.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io-client": "^4.7.5"
  }
}
