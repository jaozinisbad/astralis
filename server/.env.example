PORT=3001
JWT_SECRET=gere-uma-chave-aleatoria-e-longa
# Use a URL pooled do branch de teste localmente. Nunca envie .env ao Git.
DATABASE_URL=postgresql://usuario:senha@host-pooler/regiao/banco?sslmode=require
# PG_POOL_MAX=5
# Opcional: TURN proprio com autenticacao temporaria (coturn use-auth-secret).
